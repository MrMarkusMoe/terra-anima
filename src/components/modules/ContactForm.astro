---
/**
 * Kontaktformular im Seitendesign. Versand über Web3Forms an deine E-Mail.
 * Solange kein Key in src/data/site.ts steht, läuft es im Demo-Modus.
 */
import FormField from '@/components/ui/FormField.astro';
import Button from '@/components/ui/Button.astro';
import { forms } from '@/data/site';
import { url } from '@/lib/url';
const demo = !forms.web3formsKey;
---
<form class="contact-form" action="https://api.web3forms.com/submit" method="POST" data-demo={demo ? 'true' : undefined}>
  <input type="hidden" name="access_key" value={forms.web3formsKey} />
  <input type="hidden" name="subject" value="Neue Anfrage über die Website" />
  <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off" />

  <div class="contact-form__row">
    <FormField name="name" label="Name" required autocomplete="name" />
    <FormField name="email" label="E-Mail" type="email" required autocomplete="email" />
  </div>
  <FormField name="message" label="Deine Nachricht" type="textarea" required />

  <label class="contact-form__consent">
    <input type="checkbox" name="consent" required />
    <span>Ich bin einverstanden, dass meine Angaben zur Beantwortung meiner Anfrage verwendet werden. Mehr in der <a href={url('/datenschutz/')}>Datenschutzerklärung</a>.</span>
  </label>

  <Button type="submit">Nachricht senden</Button>
  <p class="contact-form__status" role="status" aria-live="polite"></p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('.contact-form').forEach((form) => {
    const status = form.querySelector<HTMLElement>('.contact-form__status')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (form.dataset.demo) {
        status.textContent = 'Demo-Modus: Das Formular funktioniert, sobald ein Web3Forms-Key eingetragen ist.';
        return;
      }
      status.textContent = 'Wird gesendet …';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const json = await res.json();
        if (!json.success) throw new Error();
        form.reset();
        status.textContent = 'Danke! Deine Nachricht ist angekommen – ich melde mich bald.';
      } catch {
        status.textContent = 'Das hat leider nicht geklappt. Bitte versuch es später noch einmal.';
      }
    });
  });
</script>

<style>
  .contact-form { display: grid; gap: var(--space-6); max-width: 640px; }
  .contact-form__row { display: grid; gap: var(--space-6); grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .contact-form__consent { display: flex; gap: var(--space-3); font-size: var(--text-sm); color: var(--color-muted); align-items: flex-start; }
  .contact-form__consent input { margin-top: 0.3em; accent-color: var(--color-primary); }
  .contact-form :global(.btn) { justify-self: start; }
  .contact-form__status { font-size: var(--text-sm); min-height: 1.5em; }
</style>
