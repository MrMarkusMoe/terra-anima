---
/** Fußzeile mit Kurzinfo und Rechtslinks. */
import Container from '@/components/ui/Container.astro';
import CompassMark from './CompassMark.astro';
import { site, nav, legalNav } from '@/data/site';
import { url } from '@/lib/url';
const year = new Date().getFullYear();
---
<footer class="footer">
  <Container>
    <div class="footer__grid">
      <div class="footer__brand">
        <CompassMark size={28} />
        <p><strong>{site.name}</strong><br />{site.tagline}</p>
      </div>
      <ul>{nav.map((i) => <li><a href={url(i.href)}>{i.label}</a></li>)}</ul>
      <ul>{legalNav.map((i) => <li><a href={url(i.href)}>{i.label}</a></li>)}</ul>
    </div>
    <p class="footer__copy">© {year} {site.owner} · {site.location}</p>
  </Container>
</footer>

<style>
  .footer { background: var(--color-primary); color: var(--color-primary-contrast); padding-block: var(--space-12) var(--space-8); margin-top: auto; }
  .footer a { color: inherit; text-decoration: none; opacity: 0.85; }
  .footer a:hover { opacity: 1; color: inherit; text-decoration: underline; }
  .footer__grid { display: grid; gap: var(--space-8); grid-template-columns: 2fr 1fr 1fr; }
  .footer__brand { display: flex; gap: var(--space-3); align-items: flex-start; }
  ul { list-style: none; padding: 0; display: grid; gap: var(--space-2); align-content: start; }
  .footer__copy { margin-top: var(--space-12); font-size: var(--text-sm); opacity: 0.7; }
  @media (max-width: 720px) { .footer__grid { grid-template-columns: 1fr; } }
</style>
