---
/** Die vier Kompass-Richtungen von Terra Anima als Karten. */
import Grid from '@/components/ui/Grid.astro';
import Card from '@/components/ui/Card.astro';
import Mark from '@/components/ui/Mark.astro';
import { pillars } from '@/data/pillars';
---
<Grid min="230px" as="ul">
  {pillars.map((p) => (
    <Card as="li" class="pillar">
      <Mark tone={p.id}>{p.symbol}</Mark>
      <h3>{p.title}</h3>
      <p>{p.text}</p>
    </Card>
  ))}
</Grid>

<style>
  .pillar h3 { font-size: var(--text-lg); }
  .pillar p { color: var(--color-muted); }
</style>
