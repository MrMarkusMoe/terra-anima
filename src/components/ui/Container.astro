---
/** Zentriert Inhalte auf die Seitenbreite. size="text" für Lesebreite. */
interface Props { size?: 'content' | 'text'; class?: string }
const { size = 'content', class: className } = Astro.props;
---
<div class:list={['container', `container--${size}`, className]}><slot /></div>

<style>
  .container { width: 100%; margin-inline: auto; padding-inline: var(--gutter); }
  .container--content { max-width: calc(var(--width-content) + 2 * var(--gutter)); }
  .container--text { max-width: calc(var(--width-text) + 2 * var(--gutter)); }
</style>
