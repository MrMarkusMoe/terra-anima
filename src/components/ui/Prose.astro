---
/** Formatiert Fließtext aus Markdown (Überschriften, Listen, Absätze). */
---
<div class="prose"><slot /></div>

<style>
  .prose { max-width: var(--width-text); }
  .prose :global(> * + *) { margin-top: var(--space-4); }
  .prose :global(h2) { font-size: var(--text-xl); margin-top: var(--space-12); }
  .prose :global(h3) { font-size: var(--text-lg); margin-top: var(--space-8); }
  .prose :global(ul), .prose :global(ol) { padding-left: var(--space-6); }
  .prose :global(li + li) { margin-top: var(--space-2); }
</style>
