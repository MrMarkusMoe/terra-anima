---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/modules/PageHeader.astro';
import Section from '@/components/ui/Section.astro';
import Prose from '@/components/ui/Prose.astro';
---
<BaseLayout title="Datenschutz">
  <PageHeader title="Datenschutzerklärung" />
  <Section tone="surface" size="text">
    <Prose>
      <p><strong>Platzhalter – vor der echten Veröffentlichung vollständig ausarbeiten.</strong></p>
      <h2>Hosting</h2>
      <p>Diese Website wird über GitHub Pages (GitHub Inc.) bereitgestellt. Beim Aufruf werden technisch notwendige Daten (z. B. IP-Adresse) verarbeitet.</p>
      <h2>Keine Cookies, kein Tracking</h2>
      <p>Diese Website verwendet keine Cookies und keine Analyse-Tools. Schriften werden lokal geladen.</p>
      <h2>Kontaktformular</h2>
      <p>Nachrichten werden über den Dienst Web3Forms per E-Mail zugestellt und nur zur Beantwortung deiner Anfrage verwendet.</p>
      <h2>Anmeldeformulare</h2>
      <p>Retreat-Anmeldungen laufen über Tally (Tally BV, Belgien, Server in der EU).</p>
    </Prose>
  </Section>
</BaseLayout>
